{%- comment -%}
  "Das sagen unsere Kunden" – Bewertungskarten mit Sternen, Titel, Text und Name.
  Bitte nur echte Kundenbewertungen eintragen (Fake-Bewertungen sind in der EU verboten).
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold' -%}

<style>
  {{ heading_font_bold | font_face: font_display: 'swap' }}

  #mvr-{{ sid }} {
    --mvr-heading: {{ section.settings.heading_color }};
    --mvr-card: {{ section.settings.card_bg }};
    --mvr-star: {{ section.settings.star_color }};
    background: {{ section.settings.bg }};
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    color: #1a1a1a;
  }
  @media screen and (min-width: 750px) {
    #mvr-{{ sid }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  #mvr-{{ sid }} .mvr__head { text-align: center; padding: 0 20px; margin-bottom: 32px; }
  #mvr-{{ sid }} .mvr__heading {
    margin: 0;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--mvr-heading);
  }
  #mvr-{{ sid }} .mvr__summary { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; font-size: 18px; letter-spacing: 0.04em; }
  #mvr-{{ sid }} .mvr__summary strong { font-size: 26px; }
  #mvr-{{ sid }} .mvr__stars { display: inline-flex; gap: 3px; color: var(--mvr-star); }
  #mvr-{{ sid }} .mvr__stars svg { width: 22px; height: 22px; display: block; }
  #mvr-{{ sid }} .mvr__stars .is-empty { opacity: 0.25; }

  #mvr-{{ sid }} .mvr__wrap { max-width: var(--page-width, 1200px); margin: 0 auto; padding: 0 20px; }
  @media screen and (min-width: 990px) { #mvr-{{ sid }} .mvr__wrap { padding: 0 5rem; } }
  #mvr-{{ sid }} .mvr__list {
    list-style: none;
    margin: 0;
    padding: 0 0 6px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    align-items: start;
  }
  #mvr-{{ sid }} .mvr__list::-webkit-scrollbar { display: none; }
  @media screen and (min-width: 990px) {
    #mvr-{{ sid }} .mvr__list { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); gap: 40px; overflow: visible; }
  }
  #mvr-{{ sid }} .mvr__card { scroll-snap-align: start; background: var(--mvr-card); border-radius: 14px; padding: 22px 22px 20px; text-align: center; }
  #mvr-{{ sid }} .mvr__card .mvr__stars { margin-bottom: 14px; }
  #mvr-{{ sid }} .mvr__card .mvr__stars svg { width: 24px; height: 24px; }
  #mvr-{{ sid }} .mvr__title { margin: 0 0 14px; font-size: 19px; font-weight: 700; line-height: 1.45; letter-spacing: 0.04em; }
  #mvr-{{ sid }} .mvr__text { margin: 0; font-size: 16px; line-height: 1.85; letter-spacing: 0.03em; color: #2b2b2b; }
  #mvr-{{ sid }} .mvr__author { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid rgba(0, 0, 0, 0.12); font-size: 14.5px; font-style: italic; letter-spacing: 0.04em; color: #333; }
</style>

{%- capture star -%}<svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endcapture -%}

<div id="mvr-{{ sid }}" class="mvr">
  <div class="mvr__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="mvr__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.summary_score != blank -%}
      <div class="mvr__summary">
        <span>{{ section.settings.summary_label | escape }}</span>
        <strong>{{ section.settings.summary_score | escape }}</strong>
        <span class="mvr__stars" aria-hidden="true">{% for i in (1..5) %}{{ star }}{% endfor %}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="mvr__wrap">
    <ul class="mvr__list">
      {%- for block in section.blocks -%}
        <li class="mvr__card" {{ block.shopify_attributes }}>
          <div class="mvr__stars" role="img" aria-label="{{ block.settings.stars }} von 5 Sternen">
            {%- for i in (1..5) -%}
              <span{% if i > block.settings.stars %} class="is-empty"{% endif %}>{{ star }}</span>
            {%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}
            <p class="mvr__title">„{{ block.settings.title | escape }}“</p>
          {%- endif -%}
          <p class="mvr__text">{{ block.settings.text | escape }}</p>
          {%- if block.settings.author != blank -%}
            <p class="mvr__author">{{ block.settings.author | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Bewertungen (Modava)",
  "tag": "section",
  "class": "section section-mv-reviews",
  "settings": [
    { "type": "paragraph", "content": "Bitte nur echte Bewertungen von Käufern eintragen. Erfundene Bewertungen sind nach EU-/deutschem Recht (UWG) verboten und abmahnfähig." },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das sagen unsere Kunden" },
    { "type": "text", "id": "summary_label", "label": "Gesamtbewertung: Text", "default": "Hervorragend" },
    { "type": "text", "id": "summary_score", "label": "Gesamtbewertung: Wert", "info": "z. B. 4,8 / 5 – nur echte Werte. Leer = ausgeblendet." },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Überschrift", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Karten-Hintergrund", "default": "#f2f2f2" },
    { "type": "color", "id": "star_color", "label": "Sterne", "default": "#f5b400" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand oben", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand unten", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Sterne", "default": 5 },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Bewertungstext" },
        { "type": "text", "id": "author", "label": "Name (z. B. Anna M., Hamburg)" }
      ]
    }
  ],
  "presets": [
    { "name": "Bewertungen (Modava)", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
