{%- comment -%}
  Vergleichstabelle "Wir vs. Andere" – Nachbau des histrips.com-Vergleichs
  ("What makes histrips different? / Built for real recovery.").
  Alle Texte, Bilder und Farben sind im Theme-Editor anpassbar.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Gochi+Hand&display=swap' | stylesheet_tag }}

{%- assign sid = section.id -%}
{%- assign left_image = section.settings.left_image | default: product.featured_media.preview_image -%}

<style>
  #ct-{{ sid }} {
    --ct-page-bg: {{ section.settings.page_bg }};
    --ct-frame-bg: {{ section.settings.frame_bg }};
    --ct-left-bg: {{ section.settings.left_bg }};
    --ct-right-bg: {{ section.settings.right_bg }};
    --ct-accent: {{ section.settings.annotation_color }};
    --ct-red: {{ section.settings.x_color }};
    background: var(--ct-page-bg);
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 16px {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #fff;
  }
  @media screen and (min-width: 750px) {
    #ct-{{ sid }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #ct-{{ sid }} *,
  #ct-{{ sid }} *::before,
  #ct-{{ sid }} *::after { box-sizing: border-box; }

  #ct-{{ sid }} .ct__head { text-align: center; margin: 0 auto 44px; max-width: 700px; }
  #ct-{{ sid }} .ct__eyebrow {
    margin: 0 0 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #9a9ba1;
  }
  #ct-{{ sid }} .ct__heading {
    margin: 0 0 14px;
    font-family: inherit;
    font-size: 34px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #fff;
  }
  #ct-{{ sid }} .ct__sub { margin: 0; font-size: 14px; line-height: 1.5; color: #c7c8cc; }

  #ct-{{ sid }} .ct__wrap { position: relative; max-width: 868px; margin: 0 auto; }

  #ct-{{ sid }} .ct__note {
    position: absolute;
    top: 20px;
    right: calc(100% + 28px);
    width: 110px;
    display: none;
    pointer-events: none;
  }
  #ct-{{ sid }} .ct__note-text {
    display: block;
    font-family: 'Gochi Hand', 'Comic Sans MS', cursive;
    font-size: 17px;
    line-height: 1.1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ct-accent);
    transform: rotate(-12deg);
    transform-origin: left center;
  }
  #ct-{{ sid }} .ct__note svg { display: block; margin: 8px 0 0 40px; width: 52px; height: 46px; color: var(--ct-accent); }
  @media screen and (min-width: 1100px) {
    #ct-{{ sid }} .ct__note { display: block; }
  }

  #ct-{{ sid }} .ct__frame {
    background: var(--ct-frame-bg);
    border-radius: 12px;
    padding: 10px;
  }
  #ct-{{ sid }} .ct__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 10px;
    row-gap: 0;
  }

  #ct-{{ sid }} .ct__cell { padding: 20px 18px; }
  #ct-{{ sid }} .ct__cell--left { background: var(--ct-left-bg); color: #111; }
  #ct-{{ sid }} .ct__cell--right { background: var(--ct-right-bg); color: #fff; }
  #ct-{{ sid }} .ct__cell--left:not(.ct__cell--last) { border-bottom: 1px solid #ececec; }
  #ct-{{ sid }} .ct__cell--top { border-radius: 6px 6px 0 0; }
  #ct-{{ sid }} .ct__cell--last { border-radius: 0 0 6px 6px; }

  #ct-{{ sid }} .ct__brand { padding: 16px 18px 13px; text-align: center; }
  #ct-{{ sid }} .ct__thumb {
    width: 80px;
    height: 80px;
    margin: 0 auto 13px;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #ct-{{ sid }} .ct__cell--left .ct__thumb { background: #f2f2f2; }
  #ct-{{ sid }} .ct__cell--right .ct__thumb { background: #202126; }
  #ct-{{ sid }} .ct__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #ct-{{ sid }} .ct__thumb svg { width: 70%; height: 70%; }
  #ct-{{ sid }} .ct__label {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  #ct-{{ sid }} .ct__cell--left .ct__label { color: #111; }
  #ct-{{ sid }} .ct__cell--right .ct__label { color: #fff; }

  #ct-{{ sid }} .ct__row { display: flex; align-items: flex-start; gap: 11px; }
  #ct-{{ sid }} .ct__icon {
    flex: 0 0 26px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -1px;
  }
  #ct-{{ sid }} .ct__icon svg { width: 12px; height: 12px; }
  #ct-{{ sid }} .ct__icon--check { background: #111; color: #fff; }
  #ct-{{ sid }} .ct__icon--x { background: var(--ct-red); color: #fff; }
  #ct-{{ sid }} .ct__title { margin: 0 0 4px; font-size: 15px; line-height: 1.35; font-weight: 600; letter-spacing: -0.005em; }
  #ct-{{ sid }} .ct__text { margin: 0; font-size: 12.5px; line-height: 1.55; }
  #ct-{{ sid }} .ct__cell--left .ct__title { color: #111; }
  #ct-{{ sid }} .ct__cell--left .ct__text { color: #6b6b6b; }
  #ct-{{ sid }} .ct__cell--right .ct__title { color: #fff; }
  #ct-{{ sid }} .ct__cell--right .ct__text { color: #b9bac0; }

  @media screen and (max-width: 749px) {
    #ct-{{ sid }} .ct__head { margin-bottom: 28px; }
    #ct-{{ sid }} .ct__heading { font-size: 27px; }
    #ct-{{ sid }} .ct__sub { font-size: 13px; }
    #ct-{{ sid }} .ct__frame { padding: 6px; border-radius: 10px; }
    #ct-{{ sid }} .ct__grid { column-gap: 6px; }
    #ct-{{ sid }} .ct__cell { padding: 14px 10px; }
    #ct-{{ sid }} .ct__brand { padding: 12px 8px 10px; }
    #ct-{{ sid }} .ct__thumb { width: 64px; height: 64px; margin-bottom: 10px; }
    #ct-{{ sid }} .ct__label { font-size: 11px; }
    #ct-{{ sid }} .ct__row { flex-direction: column; gap: 8px; }
    #ct-{{ sid }} .ct__icon { flex-basis: 22px; width: 22px; height: 22px; margin-top: 0; }
    #ct-{{ sid }} .ct__icon svg { width: 10px; height: 10px; }
    #ct-{{ sid }} .ct__title { font-size: 13px; }
    #ct-{{ sid }} .ct__text { font-size: 11.5px; }
  }
</style>

<div id="ct-{{ sid }}" class="ct">
  <div class="ct__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ct__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ct__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ct__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="ct__wrap">
    {%- if section.settings.show_annotation and section.settings.annotation != blank -%}
      <div class="ct__note" aria-hidden="true">
        <span class="ct__note-text">{{ section.settings.annotation | escape }}</span>
        <svg viewBox="0 0 52 46" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3c1 14 8 27 22 34 6 3 13 4 21 3"/>
          <path d="M37 33l10 7-11 4"/>
        </svg>
      </div>
    {%- endif -%}

    <div class="ct__frame">
      <div class="ct__grid">
        <div class="ct__cell ct__cell--left ct__cell--top ct__brand{% if section.blocks.size == 0 %} ct__cell--last{% endif %}">
          <div class="ct__thumb">
            {%- if left_image != blank -%}
              {{ left_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.left_label }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <p class="ct__label">{{ section.settings.left_label | escape }}</p>
        </div>
        <div class="ct__cell ct__cell--right ct__cell--top ct__brand{% if section.blocks.size == 0 %} ct__cell--last{% endif %}">
          <div class="ct__thumb">
            {%- if section.settings.right_image != blank -%}
              {{ section.settings.right_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.right_label }}
            {%- else -%}
              <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect x="8" y="20" width="48" height="26" rx="10" fill="#3a3b42"/>
                <path d="M14 27c6 3 30 3 36 0M14 39c6-3 30-3 36 0" stroke="#55565e" stroke-width="2" stroke-linecap="round"/>
              </svg>
            {%- endif -%}
          </div>
          <p class="ct__label">{{ section.settings.right_label | escape }}</p>
        </div>

        {%- for block in section.blocks -%}
          <div class="ct__cell ct__cell--left{% if forloop.last %} ct__cell--last{% endif %}" {{ block.shopify_attributes }}>
            <div class="ct__row">
              <span class="ct__icon ct__icon--check" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.2 6.3l2.4 2.4 5.2-5.4"/></svg>
              </span>
              <div>
                <p class="ct__title">{{ block.settings.left_title | escape }}</p>
                {%- if block.settings.left_text != blank -%}
                  <p class="ct__text">{{ block.settings.left_text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="ct__cell ct__cell--right{% if forloop.last %} ct__cell--last{% endif %}">
            <div class="ct__row">
              <span class="ct__icon ct__icon--x" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3.3 3.3l5.4 5.4M8.7 3.3L3.3 8.7"/></svg>
              </span>
              <div>
                <p class="ct__title">{{ block.settings.right_title | escape }}</p>
                {%- if block.settings.right_text != blank -%}
                  <p class="ct__text">{{ block.settings.right_text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vergleichstabelle",
  "tag": "section",
  "class": "section section-comparison-table",
  "settings": [
    { "type": "header", "content": "Überschrift" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überzeile", "default": "Was macht Modava anders?" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Gebaut für echte Erholung." },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Ergonomische Form schlägt gewöhnliche Kissen. Jede Nacht." },
    { "type": "header", "content": "Linke Spalte (dein Produkt)" },
    { "type": "image_picker", "id": "left_image", "label": "Bild", "info": "Leer lassen = Hauptbild des Produkts" },
    { "type": "text", "id": "left_label", "label": "Bezeichnung", "default": "Modava" },
    { "type": "header", "content": "Rechte Spalte (Andere)" },
    { "type": "image_picker", "id": "right_image", "label": "Bild" },
    { "type": "text", "id": "right_label", "label": "Bezeichnung", "default": "Andere Kissen" },
    { "type": "header", "content": "Handschrift-Hinweis" },
    { "type": "checkbox", "id": "show_annotation", "label": "Hinweis anzeigen (nur Desktop)", "default": true },
    { "type": "text", "id": "annotation", "label": "Text", "default": "Die beste Lösung" },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "page_bg", "label": "Hintergrund", "default": "#111216" },
    { "type": "color", "id": "frame_bg", "label": "Tabellenrahmen", "default": "#1c1d22" },
    { "type": "color", "id": "left_bg", "label": "Linke Spalte", "default": "#ffffff" },
    { "type": "color", "id": "right_bg", "label": "Rechte Spalte", "default": "#131418" },
    { "type": "color", "id": "x_color", "label": "X-Symbol", "default": "#e5484d" },
    { "type": "color", "id": "annotation_color", "label": "Handschrift-Hinweis", "default": "#e23fd3" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand oben", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand unten", "default": 24 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Vergleichszeile",
      "settings": [
        { "type": "text", "id": "left_title", "label": "Links: Titel (✓)", "default": "Vorteil" },
        { "type": "textarea", "id": "left_text", "label": "Links: Text" },
        { "type": "text", "id": "right_title", "label": "Rechts: Titel (✕)", "default": "Nachteil" },
        { "type": "textarea", "id": "right_text", "label": "Rechts: Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vergleichstabelle",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
