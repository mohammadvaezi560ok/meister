{%- comment -%}
  Häufige Fragen als Aufklapp-Liste.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold' -%}

<style>
  {{ heading_font_bold | font_face: font_display: 'swap' }}

  #mvq-{{ sid }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 20px {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #mvq-{{ sid }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  #mvq-{{ sid }} .mvq__inner { max-width: 820px; margin: 0 auto; }
  #mvq-{{ sid }} .mvq__heading {
    margin: 0 0 28px;
    text-align: center;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.15;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }
  #mvq-{{ sid }} details { border-bottom: 1px solid rgba(0, 0, 0, 0.12); }
  #mvq-{{ sid }} details:first-of-type { border-top: 1px solid rgba(0, 0, 0, 0.12); }
  #mvq-{{ sid }} summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 2px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  #mvq-{{ sid }} summary::-webkit-details-marker { display: none; }
  #mvq-{{ sid }} summary::after { content: '+'; font-size: 24px; font-weight: 400; line-height: 1; flex: 0 0 auto; }
  #mvq-{{ sid }} details[open] summary::after { content: '–'; }
  #mvq-{{ sid }} .mvq__answer { padding: 0 2px 18px; font-size: 15px; line-height: 1.7; letter-spacing: 0.02em; opacity: 0.85; }
  #mvq-{{ sid }} .mvq__answer p { margin: 0 0 10px; }
  #mvq-{{ sid }} .mvq__answer p:last-child { margin-bottom: 0; }
</style>

<div id="mvq-{{ sid }}" class="mvq">
  <div class="mvq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mvq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="mvq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ (Modava)",
  "tag": "section",
  "class": "section section-mv-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" },
    { "type": "checkbox", "id": "open_first", "label": "Erste Frage geöffnet", "default": false },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Überschrift", "default": "#0d1b4f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14171f" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand oben", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand unten", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ (Modava)", "blocks": [ { "type": "question" }, { "type": "question" }, { "type": "question" } ] }
  ]
}
{% endschema %}
