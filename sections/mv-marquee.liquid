{%- comment -%}
  Endlos laufendes Band mit Vorteilen (Icon + Text) oder Logos.
  Logos bitte nur verwenden, wenn es eine echte Erwähnung/Partnerschaft gibt.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold' -%}

<style>
  {{ heading_font_bold | font_face: font_display: 'swap' }}

  #mvm-{{ sid }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    #mvm-{{ sid }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  #mvm-{{ sid }} .mvm__heading {
    margin: 0 0 18px;
    padding: 0 20px;
    text-align: center;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.2;
    text-transform: uppercase;
  }
  #mvm-{{ sid }} .mvm__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  #mvm-{{ sid }} .mvm__track {
    display: flex;
    width: max-content;
    animation: mvm-scroll-{{ sid }} {{ section.settings.speed }}s linear infinite;
  }
  #mvm-{{ sid }} .mvm__group { display: flex; align-items: center; gap: 56px; padding-right: 56px; }
  @media screen and (max-width: 749px) {
    #mvm-{{ sid }} .mvm__group { gap: 34px; padding-right: 34px; }
  }
  #mvm-{{ sid }} .mvm__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.02em;
  }
  @media screen and (max-width: 749px) { #mvm-{{ sid }} .mvm__item { font-size: 15px; } }
  #mvm-{{ sid }} .mvm__icon { width: 28px; height: 28px; flex: 0 0 28px; color: {{ section.settings.icon_color }}; }
  #mvm-{{ sid }} .mvm__icon svg { width: 100%; height: 100%; display: block; }
  #mvm-{{ sid }} .mvm__logo { height: {{ section.settings.logo_height }}px; width: auto; display: block; }
  #mvm-{{ sid }}:hover .mvm__track { animation-play-state: paused; }
  @keyframes mvm-scroll-{{ sid }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    #mvm-{{ sid }} .mvm__track { animation: none; }
    #mvm-{{ sid }} .mvm__viewport { overflow-x: auto; }
  }
</style>

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'logo' and block.settings.logo != blank -%}
      <span class="mvm__item">
        {{ block.settings.logo | image_url: height: 120 | image_tag: class: 'mvm__logo', loading: 'lazy', alt: block.settings.alt }}
      </span>
    {%- elsif block.type == 'text' -%}
      <span class="mvm__item">
        {%- if block.settings.icon != 'none' -%}
          <span class="mvm__icon" aria-hidden="true">{%- render 'mv-icon', icon: block.settings.icon -%}</span>
        {%- endif -%}
        {{ block.settings.text | escape }}
      </span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div id="mvm-{{ sid }}" class="mvm">
  {%- if section.settings.heading != blank -%}
    <h2 class="mvm__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="mvm__viewport">
    <div class="mvm__track">
      {%- comment -%} Inhalt 4× (2 Hälften à 2×), damit das Band auch auf breiten Bildschirmen lückenlos läuft {%- endcomment -%}
      <div class="mvm__group">{{ items }}{{ items }}</div>
      <div class="mvm__group" aria-hidden="true">{{ items }}{{ items }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Laufband (Modava)",
  "tag": "section",
  "class": "section section-mv-marquee",
  "settings": [
    { "type": "paragraph", "content": "Presse-/Marken-Logos nur verwenden, wenn es eine echte Erwähnung gibt – sonst ist das irreführende Werbung." },
    { "type": "text", "id": "heading", "label": "Überschrift (optional)" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 2, "unit": "s", "label": "Dauer eines Durchlaufs", "default": 36 },
    { "type": "range", "id": "logo_height", "min": 16, "max": 60, "step": 2, "unit": "px", "label": "Logo-Höhe", "default": 30 },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "#0d1b4f" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Abstand oben", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Abstand unten", "default": 28 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text mit Icon",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
          { "value": "none", "label": "Kein Icon" },
          { "value": "check", "label": "Häkchen" },
          { "value": "truck", "label": "Versand" },
          { "value": "foam", "label": "Schaum / Schichten" },
          { "value": "wash", "label": "Waschbar" },
          { "value": "spine", "label": "Wirbelsäule" },
          { "value": "moon", "label": "Mond / Schlaf" },
          { "value": "heart", "label": "Herz" },
          { "value": "shield", "label": "Schild" },
          { "value": "leaf", "label": "Blatt" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Vorteil" }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Name (für Screenreader)" }
      ]
    }
  ],
  "presets": [
    { "name": "Laufband (Modava)", "blocks": [ { "type": "text" }, { "type": "text" }, { "type": "text" } ] }
  ]
}
{% endschema %}
