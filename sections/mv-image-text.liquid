{%- comment -%}
  Abwechselnde Bild/Video-Text-Zeilen ("Entlastung ab der ersten Nacht" …).
  Pro Zeile: eigenes Bild, eigenes Video (z. B. GIF als MP4) oder ein Bild des Produkts.
  Handy: Medien oben, Text darunter.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
  assign p = section.settings.product | default: product
-%}

<style>
  {{ heading_font_bold | font_face: font_display: 'swap' }}

  #mvit-{{ sid }} {
    --mvit-heading: {{ section.settings.heading_color }};
    --mvit-text: {{ section.settings.text_color }};
    background: {{ section.settings.bg }};
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #mvit-{{ sid }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  #mvit-{{ sid }} .mvit__heading {
    margin: 0 0 28px;
    padding: 0 20px;
    text-align: center;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: clamp(24px, 3.2vw, 36px);
    line-height: 1.2;
    color: var(--mvit-heading);
  }
  #mvit-{{ sid }} .mvit__rows { max-width: var(--page-width, 1200px); margin: 0 auto; padding: 0 16px; display: grid; gap: 44px; }
  @media screen and (min-width: 990px) { #mvit-{{ sid }} .mvit__rows { padding: 0 5rem; gap: 64px; } }

  #mvit-{{ sid }} .mvit__row { display: grid; gap: 20px; align-items: center; }
  @media screen and (min-width: 750px) {
    #mvit-{{ sid }} .mvit__row { grid-template-columns: 1fr 1fr; gap: 56px; }
    #mvit-{{ sid }} .mvit__row--flip .mvit__media { order: 2; }
  }
  #mvit-{{ sid }} .mvit__media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #f2f3f6;
  }
  #mvit-{{ sid }} .mvit__media img,
  #mvit-{{ sid }} .mvit__media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #mvit-{{ sid }} .mvit__media--contain img { object-fit: contain; }

  #mvit-{{ sid }} .mvit__title {
    margin: 0 0 14px;
    font-family: {{ heading_font_bold.family }}, {{ heading_font_bold.fallback_families }};
    font-weight: 700;
    font-size: clamp(23px, 2.6vw, 30px);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--mvit-heading);
  }
  #mvit-{{ sid }} .mvit__text { font-size: 15.5px; line-height: 1.75; letter-spacing: 0.02em; color: var(--mvit-text); }
  #mvit-{{ sid }} .mvit__text p { margin: 0 0 12px; }
  #mvit-{{ sid }} .mvit__text p:last-child { margin-bottom: 0; }
  #mvit-{{ sid }} .mvit__text strong { font-weight: 700; color: var(--mvit-heading); }
  @media screen and (max-width: 749px) {
    #mvit-{{ sid }} .mvit__body { padding: 0 4px; }
    #mvit-{{ sid }} .mvit__text { font-size: 15px; line-height: 1.7; }
  }
</style>

<div id="mvit-{{ sid }}" class="mvit">
  {%- if section.settings.heading != blank -%}
    <h2 class="mvit__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="mvit__rows">
    {%- for block in section.blocks -%}
      {%- liquid
        assign flip = false
        assign is_odd = forloop.index | modulo: 2
        if section.settings.first_image_right
          if is_odd == 1
            assign flip = true
          endif
        else
          if is_odd == 0
            assign flip = true
          endif
        endif

        assign fallback_media = nil
        if block.settings.product_image > 0 and p != blank
          assign media_index = block.settings.product_image | minus: 1
          assign fallback_media = p.media[media_index]
        endif
      -%}
      <div class="mvit__row{% if flip %} mvit__row--flip{% endif %}" {{ block.shopify_attributes }}>
        <div class="mvit__media{% if block.settings.image == blank and block.settings.video == blank %} mvit__media--contain{% endif %}">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata' }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200', alt: block.settings.title }}
          {%- elsif fallback_media != blank -%}
            {{ fallback_media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200', alt: block.settings.title }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="mvit__body">
          {%- if block.settings.title != blank -%}
            <h3 class="mvit__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          <div class="mvit__text">{{ block.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bild & Text (Modava)",
  "tag": "section",
  "class": "section section-mv-image-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (optional)" },
    { "type": "product", "id": "product", "label": "Produkt für Ersatzbilder", "info": "Auf der Produktseite leer lassen." },
    { "type": "checkbox", "id": "first_image_right", "label": "Erste Zeile: Bild rechts", "default": true },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Überschriften", "default": "#0d1b4f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14171f" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand oben", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Abstand unten", "default": 56 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Zeile",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (optional)", "info": "Kurze Clips/GIFs am besten als MP4 hochladen – läuft automatisch, stumm, in Schleife." },
        { "type": "image_picker", "id": "image", "label": "Bild (optional)", "info": "Auch animierte GIFs möglich." },
        { "type": "range", "id": "product_image", "min": 0, "max": 20, "step": 1, "label": "Sonst: Produktbild Nr.", "default": 2, "info": "Wird genutzt, wenn weder Video noch Bild gesetzt ist. 0 = keins." },
        { "type": "text", "id": "title", "label": "Titel", "default": "Überschrift" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Beschreibe hier einen Vorteil deines Produkts.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Bild & Text (Modava)", "blocks": [ { "type": "row" }, { "type": "row" } ] }
  ]
}
{% endschema %}
