      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "left_title": "Ergonomische Konturform",
            "left_text": "Passt sich genau zwischen die Knie an und hält Hüfte, Becken und Wirbelsäule in einer Linie.",
            "right_title": "Flach und formlos",
            "right_text": "Normale Kissen verrutschen, fallen zusammen und bieten keine gezielte Unterstützung."
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "left_title": "Hochwertiger Memory-Schaum",
            "left_text": "Formt sich nach deinem Körper und kehrt jeden Morgen in seine ursprüngliche Form zurück.",
            "right_title": "Billige Füllung",
            "right_text": "Watte oder Schaumflocken klumpen schnell und verlieren nach wenigen Wochen ihre Form."
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "left_title": "Atmungsaktiver, waschbarer Bezug",
            "left_text": "Abnehmbarer Bezug für ein frisches, hygienisches Schlafgefühl – einfach in die Waschmaschine.",
            "right_title": "Kein abnehmbarer Bezug",
            "right_text": "Schwer zu reinigen und staut Wärme, was zu unruhigem Schlaf führt."
          }
        },
        "row_4": {
          "type": "row",
          "settings": {
            "left_title": "Spürbare Entlastung (Seitenschläfer)",
            "left_text": "Reduziert den Druck auf Hüfte, Knie und unteren Rücken – für erholsamen Schlaf, Nacht für Nacht.",
            "right_title": "Überteuert",
            "right_text": "Orthopädische Spezialkissen kosten oft 50 €+ – mit Funktionen, die du gar nicht brauchst."
          }
        }
      },
